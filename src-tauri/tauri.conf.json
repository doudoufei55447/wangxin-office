{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "网信办公",
  "version": "1.0.2",
  "identifier": "com.wangxin.office",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "网信办公 · 轻量全格式读改",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "轻量全格式办公文件读改工具",
    "longDescription": "网信科技出品：不到 150MB、秒级启动、无需登录的桌面端轻量工具，能打开任意 Word/Excel/PPT/PDF 做轻量修改与批注。隐私优先，本地处理不上云。",
    "publisher": "网信科技",
    "copyright": "Copyright © 2026 网信科技",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installMode": "perMachine"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 660, "height": 460 }
      }
    }
  }
}
